<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground matches the Compose light background so the first
         frame doesn't flash a foreign color; values-night overrides both the
         parent and the background for dark mode. -->
    <style name="Theme.Kararead" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.Kararead.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kararead</item>
    </style>
</resources>
